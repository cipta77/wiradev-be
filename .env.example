# =============================================================================
# WIRADEV BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env in wiradev-be to configure the local or production server.

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
# PORT: HTTP port for the Express application server (default: 5000 or 3000)
PORT=5000

# NODE_ENV: Application environment ('development' | 'production' | 'test')
# In 'production', cookies are marked as secure (HTTPS only).
NODE_ENV=development

# FRONTEND_URL / APP_URL: Base URL of the client application (Vercel domain or localhost).
# Used for OAuth redirection and password reset email links.
# Production Vercel: https://wiradev.vercel.app
# Local development: http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=wiradev_db

# -----------------------------------------------------------------------------
# 3. Authentication & JWT Secrets
# -----------------------------------------------------------------------------
# JWT_SECRET / JWT_ACCESS_SECRET: Secret key used to sign 15-minute access tokens
JWT_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here

# JWT_REFRESH_SECRET: Secret key used to sign 7-day refresh tokens
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# JWT_RESET_SECRET: Secret key used to generate password reset tokens
JWT_RESET_SECRET=your_jwt_reset_secret_key_here

# -----------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID from Google Cloud Console
# (Matches NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=159334240812-3k5m6m19u2h5uljs0t5rckauajkovgel.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Web Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# 5. GitHub OAuth App Credentials
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID: OAuth App Client ID from GitHub Developer Settings
# (Matches NEXT_PUBLIC_GITHUB_CLIENT_ID in the frontend)
GITHUB_CLIENT_ID=your_github_client_id_here

# GITHUB_CLIENT_SECRET: OAuth App Client Secret from GitHub Developer Settings
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GITHUB_CALLBACK_URL: Authorization callback URL registered in GitHub OAuth App.
# For Vercel: https://wiradev.vercel.app/oauth-callback
# For Local: http://localhost:3000/oauth-callback
GITHUB_CALLBACK_URL=http://localhost:3000/oauth-callback

# -----------------------------------------------------------------------------
# 6. Email Service (Optional for Password Reset / Notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Wiradev" <noreply@wiradev.id>
