# =========================================================================
# HI-FI EXPRESS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and adjust the variables for your setup.
# =========================================================================

# 🖥️ Server Configurations
PORT=5000
NODE_ENV=development

# 🗄️ MySQL Database Configurations for Docker & Local Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hifi_db
DB_USER=hifi_user
DB_PASSWORD=your_mysql_password_here
DB_ROOT_PASSWORD=your_mysql_root_password_here

# Database Connection URL (Format: mysql://[user]:[password]@[host]:[port]/[database_name])
DATABASE_URL=mysql://hifi_user:your_mysql_password_here@localhost:3306/hifi_db

# 🛡️ JWT Authentication Security Secrets
# Use high-entropy random strings for production tokens.
JWT_ACCESS_SECRET=your_jwt_access_token_secret_string_here
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_string_here

# 🔑 Google OAuth Client ID
# Generated from Google Cloud Console. Must match the Frontend client ID.
# Format: <client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 📁 Application & File Upload Configuration
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# 🐙 GitHub OAuth Configuration
# Generated from GitHub Developer Settings -> OAuth Apps.
# Used for both GitHub login/sign-up and the GitHub profile integration.
# The OAuth App's "Authorization callback URL" must be set to: <APP_URL>/oauth-callback
GITHUB_CLIENT_ID=Ov23li4lsn0ehApWu2vg
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# 🤖 OpenRouter LLM (CV screening, transcript screening, jobdesk analyzer)
# Get a key at https://openrouter.ai/keys. Without it, AI analysis falls back
# to a generic heuristic result instead of a real per-document analysis.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the default primary model used for the analysis chain.
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# 🔐 Password reset
# Base secret for password-reset tokens (use a high-entropy random string).
JWT_RESET_SECRET=your_password_reset_token_secret_here

# ✉️ Email delivery (password reset, etc.)
# If SMTP_HOST is unset, emails are logged to the console (dev fallback) and
# not actually sent. Set these to enable real delivery via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wirapath <no-reply@wirapath.com>
SUPPORT_EMAIL=support@wirapath.com
